"""
Partition Graph G([n], r) Drawing Data Generator
=================================================
Computes vertex coordinates and edge set for G([n], r).

IMPORTANT:
The vertex order is standardized by canonical_partition().
So V01, V02, ... are consistent with the analyzer-code version.
"""

from collections import defaultdict
import math


# ─────────────────────────────────────────
# 0. Standard labels and ordering
# ─────────────────────────────────────────

def canonical_partition(partition):
    """
    Convert a partition into a standard ordered form.

    Example:
        ((3,1), (2,5), (4,))
    becomes:
        ((1,3), (2,5), (4,))
    """
    return tuple(sorted(tuple(sorted(block)) for block in partition))


def vertex_label(i):
    """Return vertex label like V01, V02, ..."""
    return f"V{i+1:02d}"


def partition_str(partition):
    """Pretty print a partition."""
    canonical = canonical_partition(partition)
    return " | ".join(
        "{" + ",".join(map(str, block)) + "}"
        for block in canonical
    )


# ─────────────────────────────────────────
# 1. Generate all unordered r-partitions
# ─────────────────────────────────────────

def get_r_partitions(n, r):
    """
    Return all unordered r-partitions of {1, 2, ..., n}.

    The final list is sorted by canonical_partition(),
    so the vertex order matches the analyzer code.
    """
    S = list(range(1, n + 1))
    partitions = []

    def backtrack(index, blocks):
        if index == n:
            if len(blocks) == r:
                partition = tuple(tuple(block) for block in blocks)
                partitions.append(partition)
            return

        x = S[index]

        # Put x into an existing block
        for i in range(len(blocks)):
            blocks[i].append(x)
            backtrack(index + 1, blocks)
            blocks[i].pop()

        # Start a new block with x
        if len(blocks) < r:
            blocks.append([x])
            backtrack(index + 1, blocks)
            blocks.pop()

    backtrack(0, [])

    # This makes V01, V02, ... consistent with the first code
    partitions = sorted(partitions, key=canonical_partition)

    return partitions


# ─────────────────────────────────────────
# 2. Restrict partition after removing one element
# ─────────────────────────────────────────

def restrict_partition(partition, removed):
    """
    Remove one element from a partition.
    Empty blocks disappear.
    """
    new_parts = []

    for block in partition:
        new_block = tuple(x for x in block if x != removed)

        if new_block:
            new_parts.append(new_block)

    return frozenset(new_parts)


# ─────────────────────────────────────────
# 3. Fast edge generation
# ─────────────────────────────────────────

def get_edges_fast(n, partitions):
    """
    Two partitions are adjacent if they become equal after
    removing exactly one element.
    """
    S = list(range(1, n + 1))
    buckets = defaultdict(list)

    for i, partition in enumerate(partitions):
        for x in S:
            key = (x, restrict_partition(partition, x))
            buckets[key].append(i)

    edges = []
    seen = set()

    for key, indices in buckets.items():
        for a in range(len(indices)):
            for b in range(a + 1, len(indices)):
                i = indices[a]
                j = indices[b]

                if i > j:
                    i, j = j, i

                if (i, j) not in seen:
                    seen.add((i, j))
                    edges.append((i, j))

    edges.sort()

    return edges


# ─────────────────────────────────────────
# 4. Circle layout
# ─────────────────────────────────────────

def layout_circle(num_vertices, radius=400, cx=500, cy=500):
    """
    Place vertices evenly on a circle.
    """
    coords = []

    for i in range(num_vertices):
        angle = 2 * math.pi * i / num_vertices - math.pi / 2

        x = int(cx + radius * math.cos(angle))
        y = int(cy + radius * math.sin(angle))

        coords.append((x, y))

    return coords


# ─────────────────────────────────────────
# 5. Main
# ─────────────────────────────────────────

def main():
    n = int(input("Enter n: "))
    r = int(input("Enter r: "))

    if r < 1 or r > n:
        print("Invalid r. We need 1 <= r <= n.")
        return

    partitions = get_r_partitions(n, r)
    edges = get_edges_fast(n, partitions)

    num_v = len(partitions)
    coords = layout_circle(num_v)

    # ── Vertex set with coordinates ───────────

    print("\n=== VERTEX SET ===")
    print(f"|V| = {num_v}")
    print()

    for i, (x, y) in enumerate(coords):
        print(f"{vertex_label(i)}: ({x}, {y})")

    # ── Vertex-to-partition dictionary ────────

    print("\n=== VERTEX PARTITIONS ===")
    print()

    for i, partition in enumerate(partitions):
        print(f"{vertex_label(i)}: {partition_str(partition)}")

    # ── Edge set ──────────────────────────────

    print("\n=== EDGE SET ===")
    print(f"|E| = {len(edges)}")
    print()

    for i, j in edges:
        print(f"{{{vertex_label(i)}, {vertex_label(j)}}}")


if __name__ == "__main__":
    main()
